{
  "name": "steward-suite",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Steward: the layer for owning a tokenized stock on BNB Smart Chain, not just buying one.",
  "license": "LicenseRef-zkasuran-SAND-1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --import tsx --test \"packages/*/src/**/*.test.ts\"",
    "smoke": "npm run smoke -w @steward/sdk"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
